# Maintainer: set your AUR account before submission
pkgname=ghostnet
pkgver=1.4.1
pkgrel=1
pkgdesc='Terminal launcher for native builds, project tools and 17 languages'
arch=('any')
url='https://github.com/galvatrone/CPP-Builder-Gostnet-'
license=('MIT')
depends=('bash>=4.4' 'python>=3.8' 'curl' 'coreutils' 'findutils' 'ncurses')
optdepends=('gcc: C and C++ compilation' 'rust: Rust and Cargo projects' 'go: Go projects'
            'jdk-openjdk: Java and Kotlin runtime' 'nodejs: JavaScript and TypeScript runtime'
            'npm: Node project scripts' 'typescript: standalone TypeScript compiler'
            'dotnet-sdk: C# and .NET projects' 'ruby: Ruby scripts' 'php: PHP scripts'
            'lua: Lua scripts' 'kotlin: Kotlin compiler' 'dart: Dart compiler' 'zig: Zig compiler'
            'cmake: CMake projects' 'ninja: CMake backend' 'make: Make projects'
            'mingw-w64-gcc: Windows cross compilation')
source=("$pkgname-$pkgver.zip::$url/releases/download/v$pkgver/ghostnet-linux.zip")
sha256sums=('acec7ae78afb5fe122e15eecf50122df422d7e27d09b53f0acc1b8598e9a679b')
package() {
    cd "$srcdir/GHOSTNET"
    install -Dm755 ban.sh "$pkgdir/usr/share/ghostnet/ban.sh"
    install -Dm755 ban-ru.sh "$pkgdir/usr/share/ghostnet/ban-ru.sh"
    install -Dm755 ghostnet-update.py "$pkgdir/usr/share/ghostnet/ghostnet-update.py"
    install -Dm755 ghostnet "$pkgdir/usr/bin/ghostnet"
    install -Dm755 ghostnet-ru "$pkgdir/usr/bin/ghostnet-ru"
    for helper in ghostnet.bash ghostnet.zsh ghostnet.ps1 ghostnet.1; do
        install -Dm644 "$helper" "$pkgdir/usr/share/ghostnet/$helper"
    done
    install -Dm644 ghostnet.bash "$pkgdir/usr/share/bash-completion/completions/ghostnet"
    install -Dm644 ghostnet.zsh "$pkgdir/usr/share/zsh/site-functions/_ghostnet"
    install -Dm644 ghostnet.1 "$pkgdir/usr/share/man/man1/ghostnet.1"
    printf 'aur\n' > "$pkgdir/usr/share/ghostnet/install-mode"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 README.ru.md "$pkgdir/usr/share/doc/$pkgname/README.ru.md"
}
