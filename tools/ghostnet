#!/usr/bin/env bash
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 1
selected_bash="$(command -v bash)"
if [[ "$(uname -s)" == "Darwin" ]]; then
    for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash "$selected_bash"; do
        [[ -x "$candidate" ]] || continue
        if "$candidate" -c '(( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) ))' 2>/dev/null; then
            selected_bash="$candidate"
            break
        fi
    done
fi
export PATH="$(dirname -- "$selected_bash"):$PATH"
# Only installed commands update; repository and standalone scripts remain independent.
if [[ ! -f "$root/ban.sh" && ! -f "$root/../ban.sh" ]]; then
    prefix=$(cd -- "$root/.." && pwd) || exit 1
    helper="$prefix/share/ghostnet/ghostnet-update.py"
    if [[ -f "$helper" ]]; then
        export GHOSTNET_ROOT="$prefix" GHOSTNET_UPDATE_HELPER="$helper"
        case "${1:-}" in
            update|auto-update) exec python3 "$helper" --root "$prefix" "$@" ;;
            --version|--help|-h|completion) ;;
            *) python3 "$helper" --root "$prefix" --startup >/dev/null 2>&1 || true ;;
        esac
        payload=$(python3 "$helper" --root "$prefix" --payload) || exit 1
        exec "$selected_bash" "$payload/ban.sh" "$@"
    fi
fi
if [[ -f "$root/ban.sh" ]]; then
    exec "$selected_bash" "$root/ban.sh" "$@"
elif [[ -f "$root/../ban.sh" ]]; then
    exec "$selected_bash" "$root/../ban.sh" "$@"
else
    exec "$selected_bash" "$root/../share/ghostnet/ban.sh" "$@"
fi
