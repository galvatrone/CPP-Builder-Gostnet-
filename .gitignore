__pycache__/
*.pyc
.ghostnet-build/
.venv/

# Auxiliary runtime files are public; development helpers stay local
/tools/*
!/tools/ghostnet
!/tools/ghostnet-ru
!/tools/install.sh
!/tools/GHOSTNET-Install.cmd
!/tools/GHOSTNET-Install.sh
!/tools/GHOSTNET-Install.command
!/tools/ban.cmd
!/tools/ban-ru.cmd
!/tools/ban.command
!/tools/ban-ru.command

/tests/

/test_data/

/examples/

/launchers/

/docs/

/downloads/


# Preserve local exclusions
/tests/test_data/
/gostnet
/gostnet-ru

# Update runtime is public; AUR build outputs stay local
!/tools/ghostnet-update.py
!/tools/aur/
/tools/aur/*
!/tools/aur/PKGBUILD
!/tools/aur/.SRCINFO

# Shell help belongs to the installed runtime
!/tools/ghostnet.bash
!/tools/ghostnet.zsh
!/tools/ghostnet.ps1
!/tools/ghostnet.1
